{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/revanth-ainl/ainexlayer-marketplace/main/schemas/submission.schema.json",
  "title": "Marketplace submission (what AIAgentLayer's Publish button sends)",
  "$comment": "Documentation; scripts/validate.py is the authority and checks more than a schema can.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "kind",
        "name",
        "version",
        "title",
        "description",
        "skill_md"
      ],
      "properties": {
        "kind": {
          "const": "skill"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?$",
          "not": {
            "pattern": "--|\\.\\."
          }
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "publisher": {
          "description": "Ignored; ownership comes from registry.json."
        },
        "publisher_id": {
          "description": "Ignored; ownership comes from registry.json."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "At most 500 UTF-16 code units (checked by the validator)."
        },
        "categories": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "skill_md": {
          "type": "string",
          "minLength": 1
        },
        "flavor": {
          "enum": [
            "jarvis",
            "portable"
          ]
        },
        "compatible_agents": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Each name at most 32 characters once spaces are collapsed."
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "name",
        "version",
        "plugin_json"
      ],
      "properties": {
        "kind": {
          "const": "plugin"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?$",
          "not": {
            "pattern": "--|\\.\\."
          }
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "publisher": {
          "description": "Ignored; ownership comes from registry.json."
        },
        "publisher_id": {
          "description": "Ignored; ownership comes from registry.json."
        },
        "plugin_json": {
          "$ref": "plugin.schema.json"
        },
        "mcp_json": {
          "anyOf": [
            {
              "$ref": "mcp.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_card": {
          "type": [
            "string",
            "null"
          ]
        },
        "skills": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "name",
              "skill_md"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?$",
                "not": {
                  "pattern": "--|\\.\\."
                }
              },
              "skill_md": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "name",
        "version",
        "title",
        "description",
        "agent"
      ],
      "properties": {
        "kind": {
          "const": "agent"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?$",
          "not": {
            "pattern": "--|\\.\\."
          }
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "publisher": {
          "description": "Ignored; ownership comes from registry.json."
        },
        "publisher_id": {
          "description": "Ignored; ownership comes from registry.json."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "At most 500 UTF-16 code units (checked by the validator)."
        },
        "categories": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "agent": {
          "$ref": "agent-template.schema.json"
        }
      },
      "additionalProperties": false
    }
  ],
  "description": "The serialised submission is at most 131072 bytes."
}
