{
  "kind": "plugin",
  "name": "notes-index",
  "version": "2.1.0",
  "plugin_json": {
    "name": "notes-index",
    "version": "2.1.0",
    "description": "Search a local notes index through a pinned MCP server.",
    "extensions": {
      "io.github.dodaios": {
        "auth": {
          "mode": "pat_paste"
        }
      }
    }
  },
  "mcp_json": {
    "mcpServers": {
      "notes-index": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@example/notes-index-mcp@2.1.0"
        ],
        "env": {
          "NOTES_TOKEN": "$plugin_notes-index_token"
        }
      }
    }
  }
}
